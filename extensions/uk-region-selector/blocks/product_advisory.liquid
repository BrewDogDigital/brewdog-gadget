{% comment %}
  Scotland Advisory - Product Pages Block
  Shows MUP advisory message for Scotland customers on product pages
{% endcomment %}

{% comment %} Load MUP error handler script {% endcomment %}
<script src="{{ 'mup-error-handler.js' | asset_url }}" defer></script>

<style>
.scotland-advisory {
  padding: 1rem;
  margin: 0rem 0rem 1.5rem 0rem;
  background-color: #f5f5f5;
  border: 1px solid lightgray;
  border-radius: 20px;
  display: flex;
  gap: 0.75rem;
}
.scotland-advisory__icon {
  font-size: 1.25rem;
  flex-shrink: 0;
}
.scotland-advisory__content {
  flex: 1;
}
.scotland-advisory__title {
  font-weight: 600;
  font-size: 0.875rem;
  color: black;
  margin-bottom: 0.5rem;
}
.scotland-advisory__text {
  font-size: 0.875rem;
  color: grey;
  line-height: 1.5;
}
.product .scotland-advisory {
  margin-top: 1.5rem;
}
</style>

{% if block.settings.show_generic_advisory != false %}
  <div
    class="scotland-advisory scotland-advisory--product"
    data-scotland-advisory="product-{{ block.id }}"
    style="display: none; background-color: {{ block.settings.advisory_background_color | default: '#f5f5f5' }};"
  >
    <div class="scotland-advisory__icon">{{ block.settings.icon | default: "ℹ️" }}</div>
    <div class="scotland-advisory__content">
      <div
        class="scotland-advisory__title"
        style="color: {{ block.settings.advisory_title_color | default: '#000000' }};"
      >
        {{ block.settings.title | default: "Minimum unit pricing applies in Scotland" }}
      </div>

      <div
        class="scotland-advisory__text"
        style="color: {{ block.settings.advisory_text_color | default: '#808080' }};"
      >
        {{ block.settings.message | default: "Prices must stay above £0.65 per unit. Invalid discounts will be adjusted." }}
      </div>
    </div>
  </div>
{% endif %}

<script>
  (function() {
    const autoInjectSelector = {{ block.settings.auto_inject_selector | json }};
    const advisory = document.querySelector('[data-scotland-advisory="product-{{ block.id }}"]');
    const showViolationBanner = {% if block.settings.show_violation_banner == false %}false{% else %}true{% endif %};
    const violationInjectSelector = {{ block.settings.violation_inject_selector | default: '.mup_mesages' | json }};
    const violationTitle = {{ block.settings.violation_title | default: 'MUP Violation' | json }};
    const customViolationMessage = {{ block.settings.violation_message | json }};
    const violationBackgroundColor = {{ block.settings.violation_background_color | default: '#fee2e2' | json }};
    const violationBorderColor = {{ block.settings.violation_border_color | default: '#dc2626' | json }};
    const violationTitleColor = {{ block.settings.violation_title_color | default: '#991b1b' | json }};
    const violationTextColor = {{ block.settings.violation_text_color | default: '#7f1d1d' | json }};
    
    // Auto-inject if selector is provided
    if (autoInjectSelector && autoInjectSelector.trim() !== '') {
      const targetElement = document.querySelector(autoInjectSelector);
      if (targetElement && advisory) {
        // Clone the advisory and inject it
        const clonedAdvisory = advisory.cloneNode(true);
        clonedAdvisory.setAttribute('data-scotland-advisory', 'product-{{ block.id }}-injected');
        targetElement.insertAdjacentElement('afterend', clonedAdvisory);
        
        // Hide the original block
        advisory.style.display = 'none';
        
        // Update reference to use the injected one
        const injectedAdvisory = document.querySelector('[data-scotland-advisory="product-{{ block.id }}-injected"]');
        
        fetch('/cart.js')
          .then(response => response.json())
          .then(cart => {
            const region = cart.attributes?.uk_region;
            if (region === 'scotland' && injectedAdvisory) {
              injectedAdvisory.style.display = 'flex';
            }
          })
          .catch(error => console.error('Error checking region:', error));
      } else {
        console.warn('Auto-inject target not found:', autoInjectSelector);
      }
    } else {
      // No auto-inject, show in block position
      fetch('/cart.js')
        .then(response => response.json())
        .then(cart => {
          const region = cart.attributes?.uk_region;
          if (region === 'scotland' && advisory) {
            advisory.style.display = 'flex';
          }
        })
        .catch(error => console.error('Error checking region:', error));
    }


    // Function to show MUP violation error banner
    async function showMupViolationBanner(errorDetails) {
      if (!showViolationBanner) return;

      // Remove any existing error banners
      const existingBanners = document.querySelectorAll('.mup-violation-banner');
      existingBanners.forEach(banner => banner.remove());

      const banner = document.createElement('div');
      banner.className = 'mup-violation-banner scotland-advisory';
      banner.style.backgroundColor = violationBackgroundColor;
      banner.style.border = `1px solid ${violationBorderColor}`;
      banner.style.borderRadius = '0.375rem';
      banner.style.padding = '1rem';
      banner.style.margin = '1rem 0';
      banner.style.display = 'flex';
      banner.style.gap = '0.75rem';
      
      const errorMessage = customViolationMessage?.trim() || errorDetails.message ||
        'Your discount reduces the price below the legal minimum unit price for Scotland. Please remove your discount code to proceed with checkout.';
      
      const bannerContent = document.createElement('div');
      bannerContent.style.display = 'flex';
      bannerContent.style.gap = '0.75rem';
      bannerContent.innerHTML = `
        <div class="scotland-advisory__icon">🍺</div>
        <div class="scotland-advisory__content" style="flex: 1;">
          <div class="scotland-advisory__title" style="color: ${violationTitleColor};">${violationTitle}</div>
          <div class="scotland-advisory__text" style="color: ${violationTextColor};">${errorMessage}</div>
        </div>
      `;
      banner.appendChild(bannerContent);

      // Prefer the configured message container, then fall back to the product form.
      let messageContainer = null;
      try {
        messageContainer = violationInjectSelector
          ? document.querySelector(violationInjectSelector)
          : null;
      } catch (error) {
        console.warn('[MUP Advisory] Invalid violation banner selector:', violationInjectSelector);
      }

      if (messageContainer) {
        messageContainer.prepend(banner);
      } else {
        const productForm = document.querySelector('.product-form') ||
                           document.querySelector('form[action*="/cart/add"]') ||
                           document.querySelector('[data-product-form]') ||
                           advisory?.parentElement ||
                           document.body;

        if (productForm === document.body) {
          productForm.prepend(banner);
        } else {
          productForm.insertAdjacentElement('afterend', banner);
        }
      }

      // Scroll to banner if possible
      setTimeout(() => {
        banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }, 100);
    }

    // Listen for MUP violation events (from mup-error-handler.js)
    document.addEventListener('mup:violation-detected', (event) => {
      const errorDetails = event.detail?.error || {};
      console.log('[MUP Advisory] MUP violation detected:', errorDetails);
      showMupViolationBanner(errorDetails);
    });

    // Also listen for product-add-to-cart-failed events (fallback)
    document.addEventListener('product-add-to-cart-failed', (event) => {
      const error = event.detail?.error || event.detail;
      if (error && (
        (typeof error === 'string' && error.toLowerCase().includes('minimum unit pricing')) ||
        (error.message && error.message.toLowerCase().includes('minimum unit pricing'))
      )) {
        console.log('[MUP Advisory] MUP violation detected from product-add-to-cart-failed');
        showMupViolationBanner({ message: error.message || error });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Product Advisory",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "auto_inject_selector",
      "label": "Auto-inject CSS Selector (optional)",
      "info": "e.g., .product-form, #product-details - Leave blank to disable auto-injection"
    },
    {
      "type": "checkbox",
      "id": "show_generic_advisory",
      "label": "Show general Scotland advisory",
      "default": true
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Icon",
      "default": "ℹ️"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Minimum unit pricing applies in Scotland"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "Prices must stay above £0.65 per unit. Invalid discounts will be adjusted."
    },
    {
      "type": "color",
      "id": "advisory_background_color",
      "label": "Advisory background colour",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "advisory_title_color",
      "label": "Advisory heading colour",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "advisory_text_color",
      "label": "Advisory text colour",
      "default": "#808080"
    },
    {
      "type": "checkbox",
      "id": "show_violation_banner",
      "label": "Show MUP violation errors",
      "default": true
    },
    {
      "type": "text",
      "id": "violation_inject_selector",
      "label": "Violation message container",
      "info": "CSS selector for the container that receives the error banner.",
      "default": ".mup_mesages"
    },
    {
      "type": "text",
      "id": "violation_title",
      "label": "Violation heading",
      "default": "MUP Violation"
    },
    {
      "type": "textarea",
      "id": "violation_message",
      "label": "Custom violation message",
      "info": "Leave blank to show Shopify's detailed error including current and minimum prices."
    },
    {
      "type": "color",
      "id": "violation_background_color",
      "label": "Violation background colour",
      "default": "#fee2e2"
    },
    {
      "type": "color",
      "id": "violation_border_color",
      "label": "Violation border colour",
      "default": "#dc2626"
    },
    {
      "type": "color",
      "id": "violation_title_color",
      "label": "Violation heading colour",
      "default": "#991b1b"
    },
    {
      "type": "color",
      "id": "violation_text_color",
      "label": "Violation text colour",
      "default": "#7f1d1d"
    }
  ]
}
{% endschema %}
