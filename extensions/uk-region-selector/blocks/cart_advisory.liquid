{% comment %}
  Scotland Advisory - Cart Page Block
  Shows MUP advisory message with levy estimate for Scotland customers
{% endcomment %}

<style>
.scotland-advisory {
  padding: 1rem;
  margin: 0rem 0rem 1.5rem 0rem;
  background-color: #f5f5f5;
  border: 1px solid lightgray;
  border-radius: 20px;
  display: flex;
  gap: 0.75rem;
}
.scotland-advisory__icon {
  font-size: 1.25rem;
  flex-shrink: 0;
}
.scotland-advisory__content {
  flex: 1;
}
.scotland-advisory__title {
  font-weight: 600;
  font-size: 0.875rem;
  color: black;
  margin-bottom: 0.5rem;
}
.scotland-advisory__text {
  font-size: 0.875rem;
  color: grey;
  line-height: 1.5;
}
.scotland-advisory__levy-estimate {
  margin-top: 0.75rem;
  padding-top: 0.75rem;
  border-top: 1px solid grey;
  font-size: 0.875rem;
  color: grey;
}
.scotland-advisory__levy-estimate strong {
  font-weight: 600;
}
.scotland-advisory__levy-amount {
  margin-bottom: 0.5rem;
}
.main-cart .scotland-advisory {
  margin-top: 1rem;
}

/* Hide the original element when it has been cloned and injected elsewhere */
.scotland-advisory--relocated {
  display: none !important;
}

/* CSS-driven visibility — body class persists through AJAX section re-renders.
   Only targets the active (injected or in-place) copy, not the relocated original.
   !important overrides the inline style="display:none" on the advisory element. */
body.mup-scotland .scotland-advisory--cart:not(.scotland-advisory--relocated) {
  display: flex !important;
}
</style>

<div 
  class="scotland-advisory scotland-advisory--cart" 
  data-scotland-advisory="cart-{{ block.id }}"
  style="display: none;"
>
  <div class="scotland-advisory__icon">{{ block.settings.icon | default: "🍺" }}</div>
  <div class="scotland-advisory__content">
    <div class="scotland-advisory__title">
      {{ block.settings.title | default: "Minimum Unit Pricing Applies" }}
    </div>
    
    <div class="scotland-advisory__text">
      {{ block.settings.message | default: "Scotland customers: MUP levy charges may be added at checkout if discounts reduce prices below the legal minimum (£0.65 per unit)." }}
    </div>
      
      <div class="scotland-advisory__levy-estimate" id="scotlandLevyEstimate">
        <!-- Debug: Cart items count = {{ cart.items.size }} -->
        {%- liquid
          assign minimum_unit_price = 0.65
          assign total_levy_estimate = 0
          
          for item in cart.items
            assign is_mup_levy = item.properties.mup
            if is_mup_levy == 'true'
              continue
            endif
            
            assign units_per_item = item.variant.metafields.custom.total_units
            if units_per_item
              assign item_minimum_price = units_per_item | times: minimum_unit_price | times: 100
              assign item_levy = item_minimum_price | minus: item.variant.price | times: item.quantity
              
              if item_levy > 0
                assign total_levy_estimate = total_levy_estimate | plus: item_levy
              endif
            endif
          endfor
        -%}
        
        <!-- Debug: Total levy estimate = {{ total_levy_estimate }} -->
        {{ }}
        {% for item in cart.items %}
          {% assign units = item.variant.metafields.custom.total_units %}
          {% if units %}
            {% assign min_price = units | times: 0.65 | times: 100 %}
            {% assign levy_needed = min_price | minus: item.variant.price %}
            <!-- Debug Item: {{ item.title }} -->
            <!-- Units: {{ units }} | Min Required: {{ min_price }} (£{{ units | times: 0.65 }}) -->
            <!-- Variant Price (base): {{ item.variant.price }} (£{{ item.variant.price | divided_by: 100.0 }}) -->
            <!-- Original Price (after transform): {{ item.original_price }} (£{{ item.original_price | divided_by: 100.0 }}) -->
            <!-- Levy Needed: {{ levy_needed }} (£{{ levy_needed | divided_by: 100.0 }}) -->
            <!-- Final Price: {{ item.final_price }} | Qty: {{ item.quantity }} -->
          {% endif %}
        {% endfor %}
        
        {% if total_levy_estimate > 0 %}
          <div class="scotland-advisory__levy-amount">
            <strong>{{ block.settings.levy_label | default: "Provisional Levy:" }}</strong> 
            {{ total_levy_estimate | money }}
          </div>
          <small>{{ block.settings.levy_note | default: "Final levy calculated at checkout" }}</small>
        {% else %}
          <div style="font-size: 0.75rem;">
            {{ block.settings.no_levy_message | default: "No levy required." }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  <script>
    (function() {
      console.log('[Cart Advisory] Initializing...');
      
      const autoInjectSelector = {{ block.settings.auto_inject_selector | json }};
      const advisory = document.querySelector('[data-scotland-advisory="cart-{{ block.id }}"]');
      
      console.log('[Cart Advisory] Auto-inject selector:', autoInjectSelector);
      console.log('[Cart Advisory] Advisory element:', advisory);

      // Read mup_region cookie synchronously — avoids race condition with
      // global_selector's async /cart/update.js re-sync on page load.
      function getCookie(name) {
        const value = '; ' + document.cookie;
        const parts = value.split('; ' + name + '=');
        if (parts.length === 2) return parts.pop().split(';').shift();
        return null;
      }

      // Set a body class immediately from the cookie.
      // This class persists through every AJAX section re-render because the
      // <body> element is never replaced — only the section innerHTML is.
      // The CSS rule "body.mup-scotland .scotland-advisory--cart { display:flex !important }"
      // then keeps the advisory visible without any JS needing to re-run.
      const initialRegion = getCookie('mup_region');
      if (initialRegion === 'scotland') {
        document.body.classList.add('mup-scotland');
      } else {
        document.body.classList.remove('mup-scotland');
      }
      
      // Auto-inject if selector is provided
      if (autoInjectSelector && autoInjectSelector.trim() !== '') {
        const targetElement = document.querySelector(autoInjectSelector);
        console.log('[Cart Advisory] Target element:', targetElement);
        
        if (targetElement && advisory) {
          // Clone the advisory and inject it into the target element
          const clonedAdvisory = advisory.cloneNode(true);
          clonedAdvisory.setAttribute('data-scotland-advisory', 'cart-{{ block.id }}-injected');
          // Remove the inline display:none so the CSS body class rule can control it
          clonedAdvisory.style.display = '';
          targetElement.insertAdjacentElement('afterend', clonedAdvisory);
          
          // Mark the original as relocated (CSS hides it with !important)
          // Using a class instead of inline style so the CSS rule above can
          // specifically target the active injected copy only.
          advisory.classList.add('scotland-advisory--relocated');
          
          console.log('[Cart Advisory] Injected after target element');
          
          // Check region and show if Scotland
          checkRegionAndShow('cart-{{ block.id }}-injected');
        } else {
          console.warn('[Cart Advisory] Auto-inject target not found:', autoInjectSelector);
        }
      } else {
        console.log('[Cart Advisory] No auto-inject, showing in block position');
        // No auto-inject, show in block position
        checkRegionAndShow('cart-{{ block.id }}');
      }
      
      function checkRegionAndShow(advisoryId) {
        // 1. Check cookie first — instant, no async, no race condition.
        //    The mup_region cookie is always in sync because we write it on
        //    every selection AND the global selector re-syncs it on init.
        const cookieRegion = getCookie('mup_region');
        if (cookieRegion) {
          console.log('[Cart Advisory] Region from cookie:', cookieRegion);
          updateAdvisory(cookieRegion, advisoryId);
          return;
        }

        // 2. Cookie absent — fall back to uwp-cart element or cart.js fetch.
        const uwpCart = document.querySelector('uwp-cart');
        
        if (uwpCart) {
          // Synchronous path — data already available on the element
          try {
            const cartData = JSON.parse(uwpCart.getAttribute('cart-data'));
            const region = cartData.attributes?.uk_region;
            updateAdvisory(region, advisoryId);
          } catch(e) {
            console.error('[Cart Advisory] Failed to parse uwp-cart data:', e);
          }
        } else {
          // Async path — only call updateAdvisory inside .then(), never outside
          fetch('/cart.js')
            .then(response => response.json())
            .then(cart => {
              const region = cart.attributes?.uk_region;
              updateAdvisory(region, advisoryId);
            })
            .catch(error => console.error('[Cart Advisory] Error checking region:', error));
        }
      }
      
      function updateAdvisory(region, advisoryId) {
        const advisoryElement = document.querySelector('[data-scotland-advisory="' + advisoryId + '"]');
        console.log('[Cart Advisory] Region:', region);
        console.log('[Cart Advisory] Advisory ID:', advisoryId);
        console.log('[Cart Advisory] Advisory element found:', !!advisoryElement);
        
        if (region === 'scotland' && advisoryElement) {
          advisoryElement.style.display = 'flex';
          console.log('[Cart Advisory] Showing advisory for Scotland');
        } else if (advisoryElement) {
          advisoryElement.style.display = 'none';
          console.log('[Cart Advisory] Hiding advisory (not Scotland)');
        } else {
          console.error('[Cart Advisory] Advisory element not found!');
        }
      }

      // Also respond to live region changes within the same page load
      window.addEventListener('regionChanged', (e) => {
        const region = e.detail?.region;
        // Keep body class in sync so CSS rule stays correct after a live change
        if (region === 'scotland') {
          document.body.classList.add('mup-scotland');
        } else {
          document.body.classList.remove('mup-scotland');
        }
        const activeId = autoInjectSelector && autoInjectSelector.trim() !== ''
          ? 'cart-{{ block.id }}-injected'
          : 'cart-{{ block.id }}';
        updateAdvisory(region, activeId);
      });

      // Re-apply advisory after any cart section re-render (quantity change, etc.)
      // The Section Rendering API replaces the DOM, resetting display:none,
      // so we must re-run the cookie check each time the section reloads.
      function reApplyAdvisory() {
        const cookieRegion = getCookie('mup_region');
        if (!cookieRegion) return;

        // The advisory element may have been replaced — re-query from DOM
        const activeId = autoInjectSelector && autoInjectSelector.trim() !== ''
          ? 'cart-{{ block.id }}-injected'
          : 'cart-{{ block.id }}';

        // Small delay to let the new HTML settle into the DOM
        setTimeout(() => updateAdvisory(cookieRegion, activeId), 50);
      }

      // Shopify's native section rendering event
      document.addEventListener('shopify:section:load', reApplyAdvisory);

      // Common custom cart events fired by Shopify themes
      document.addEventListener('cart:updated',  reApplyAdvisory);
      document.addEventListener('cart:refresh',  reApplyAdvisory);
      document.addEventListener('cart:rendered', reApplyAdvisory);

      // MutationObserver — re-injects the advisory when the cart section
      // re-renders (qty change, remove item, etc.) and wipes the clone.
      //
      // Root cause: Shopify Section Rendering replaces the entire section HTML,
      // removing the injected clone. The previous observer only looked for
      // style="display:none" changes, but the element was fully gone, not hidden.
      //
      // Fix: store the original HTML as a template once, then re-inject it
      // whenever the injected clone is missing from the DOM.
      const injectedId = 'cart-{{ block.id }}-injected';
      const templateHTML = advisory ? advisory.outerHTML : null;

      function reinjectIfMissing() {
        // Only needed when auto-inject is configured
        if (!autoInjectSelector || autoInjectSelector.trim() === '') return;
        if (!templateHTML) return;

        // If the injected clone is still in the DOM, nothing to do
        if (document.querySelector('[data-scotland-advisory="' + injectedId + '"]')) return;

        // Find the target element again (it was also replaced by re-render)
        const target = document.querySelector(autoInjectSelector);
        if (!target) return;

        // Build a fresh clone from the stored template and insert it
        const tmp = document.createElement('div');
        tmp.innerHTML = templateHTML;
        const freshClone = tmp.firstElementChild;
        if (!freshClone) return;

        freshClone.setAttribute('data-scotland-advisory', injectedId);
        freshClone.classList.remove('scotland-advisory--relocated'); // templateHTML was captured after this class was added — strip it so CSS shows the clone
        freshClone.style.display = ''; // CSS body.mup-scotland controls visibility
        target.insertAdjacentElement('afterend', freshClone);
        console.log('[Cart Advisory] Re-injected after section re-render');
      }

      const observer = new MutationObserver(reinjectIfMissing);
      observer.observe(document.body, { childList: true, subtree: true });
    })();
  </script>

{% schema %}
{
  "name": "Cart Advisory",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "auto_inject_selector",
      "label": "Auto-inject CSS Selector (optional)",
      "info": "e.g., .cart-summary, #cart-totals - Leave blank to disable auto-injection",
      "default": ".mupbox"
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Icon",
      "default": "🍺"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Minimum Unit Pricing Applies"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Message",
      "default": "Scotland customers: MUP levy charges may be added at checkout if discounts reduce prices below the legal minimum (£0.65 per unit)."
    },
    {
      "type": "text",
      "id": "levy_label",
      "label": "Levy Label",
      "default": "Provisional Levy:"
    },
    {
      "type": "text",
      "id": "levy_note",
      "label": "Levy Note",
      "default": "Final levy calculated at checkout"
    },
    {
      "type": "text",
      "id": "no_levy_message",
      "label": "No Levy Message",
      "default": "No levy required."
    }
  ]
}
{% endschema %}
